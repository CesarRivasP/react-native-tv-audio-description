{
  "name": "react-native-tv-audio-description",
  "version": "0.1.0",
  "description": "Speak AI-generated audio description in the gaps between dialogue, on the TV itself: duck the film, play the cue, restore — driven from the remote, with three verbosity levels.",
  "license": "MIT",
  "author": "César Rivas",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CesarRivasP/react-native-tv-audio-description.git"
  },
  "homepage": "https://github.com/CesarRivasP/react-native-tv-audio-description#readme",
  "bugs": "https://github.com/CesarRivasP/react-native-tv-audio-description/issues",
  "keywords": [
    "react-native",
    "tv",
    "fire-tv",
    "vega",
    "accessibility",
    "audio-description",
    "a11y",
    "mse"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./vega": {
      "types": "./lib/vega/index.d.ts",
      "default": "./lib/vega/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "PLATFORM.md",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf lib && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "example": "tsx example/node/index.ts",
    "release:check": "node scripts/check-release.mjs",
    "version": "node scripts/check-release.mjs --changelog-only",
    "prepublishOnly": "npm run release:check && npm run typecheck && npm test && npm run build",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "@amazon-devices/react-native-kepler": "~4.0.0",
    "@amazon-devices/react-native-w3cmedia": "~2.3.2",
    "react": "^19.2.0",
    "react-native": "^0.83.0"
  },
  "peerDependenciesMeta": {
    "@amazon-devices/react-native-kepler": {
      "optional": true
    },
    "@amazon-devices/react-native-w3cmedia": {
      "optional": true
    }
  },
  "devDependencies": {
    "@amazon-devices/react-native-kepler": "~4.0.0",
    "@amazon-devices/react-native-w3cmedia": "~2.3.2",
    "@babel/core": "^7.29.7",
    "@react-native/babel-preset": "0.83.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "react": "19.2.0",
    "react-native": "0.83.0",
    "react-test-renderer": "19.2.0",
    "tsx": "^4.23.15",
    "typescript": "~5.6"
  }
}
