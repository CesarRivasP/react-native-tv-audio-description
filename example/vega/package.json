{
  "name": "tvad-example-vega",
  "version": "0.1.0",
  "private": true,
  "description": "react-native-tv-audio-description on Vega OS: a 20 s excerpt of Tears of Steel with four description cues, from the remote.",
  "scripts": {
    "lib": "cd ../.. && npm pack --pack-destination example/vega && cd example/vega && npm install ./react-native-tv-audio-description-0.1.0.tgz",
    "start": "react-native start",
    "build:debug": "react-native build-vega --build-type Debug",
    "build:release": "react-native build-vega --build-type Release",
    "beacon": "node beacon.mjs"
  },
  "dependencies": {
    "@amazon-devices/react-native-kepler": "~4.0.0",
    "@amazon-devices/react-native-w3cmedia": "~2.3.2",
    "react": "19.2.0",
    "react-native": "0.83.0",
    "react-native-tv-audio-description": "file:react-native-tv-audio-description-0.1.0.tgz"
  },
  "devDependencies": {
    "@amazon-devices/kepler-cli-platform": "^0",
    "@react-native-community/cli": "20.0.0",
    "@react-native/babel-preset": "0.83.0",
    "@react-native/metro-config": "0.83.0",
    "@react-native/typescript-config": "0.83.0",
    "@types/react": "^19.2.0",
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">=20"
  },
  "kepler": {
    "projectType": "application",
    "appName": "tvadexample",
    "targets": [
      "tv"
    ]
  }
}
